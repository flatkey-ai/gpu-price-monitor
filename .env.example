# No automatic .env discovery. Load explicitly with:
# gpu-price-monitor status --env-file .env
# Python: Settings.from_env(env_file=".env")
# Process environment overrides file values, including empty values.
# Values are literal: no variable interpolation or shell execution.
# Public collectors do not require payment or provider credentials.
# UCloud and the optional Lambda API source use your own credentials.
GPU_PRICE_MONITOR_PROVIDERS=nebius,crusoe
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2

# Lambda defaults to the public page, even if an API key exists.
LAMBDA_SOURCE=public
# Only used when LAMBDA_SOURCE=api or CLI --lambda-source api is explicit.
LAMBDA_API_KEY=
# Nebius estimate API only; public pricing docs need no token.
NEBIUS_ACCESS_TOKEN=
# UCloud quotes; private key stays client-side.
UCLOUD_PUBLIC_KEY=
UCLOUD_PRIVATE_KEY=
# Optional default project; required by UCloud for sub-accounts.
UCLOUD_PROJECT_ID=
# UCloud requires ONE source of full hourly GPU host quote configurations.
# Recommended: copy configs/ucloud-targets.example.json to your own local file,
# then set this path. Relative paths use the env file's directory, otherwise cwd.
UCLOUD_PRICE_TARGETS_FILE=
# Alternative: inject a JSON array as a single environment value.
# Do not set both FILE and JSON to non-empty values in the same layer.
# Either process key selects the process layer for BOTH target source keys,
# even if empty (which clears the file layer's target source).
UCLOUD_PRICE_TARGETS_JSON=
# Reserved for future account/market sources. The free AutoDL homepage
# collector ignores tokens and storage state and always uses a fresh context.
AUTODL_TOKEN=
AUTODL_STORAGE_STATE_PATH=
