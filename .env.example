# Load explicitly: gpu-price-monitor status --env-file .env
# Python: Settings.from_env(env_file=".env")
# No automatic .env discovery, variable interpolation, or shell execution.
# Process environment overrides file values, including empty values.
# Supports nebius,lambda,crusoe,autodl,ucloud,runpod,digitalocean,verda,azure.
# --providers all selects these nine; AutoDL collection needs the browser extra.
# Lambda's optional manual-login setup also uses it; console collection is HTTP.
# RunPod, DigitalOcean, Verda, and Azure require no additional env variables.
# Azure currently queries four fixed verified GPU SKUs, not the full VM catalog.
# Public modes require no provider credentials and do not create resources.
GPU_PRICE_MONITOR_PROVIDERS=nebius,lambda,crusoe,autodl,ucloud,runpod,digitalocean,verda,azure
# configured: preserve the explicit per-provider SOURCE settings below (default).
# api_preferred: prefer supported APIs, with code-only public-page collectors
# when no suitable API is selected. Nebius public adds website JSON on-demand
# catalog to its Spot API; Lambda selects its API when a key exists; UCloud selects its UHost quote API
# when either key exists (both keys and valid targets are then required).
# api_only: disallow HTML/DOM sources; unsupported providers return errors.
# An API authentication, transport, or parsing failure never falls back to a page.
# For the original five providers with API preference, use .env.five.example.
GPU_PRICE_MONITOR_SOURCE_POLICY=configured
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2

# configured + public reads Compute documentation and the anonymous Spot API.
# api_preferred + public adds the official website JSON on-demand catalog.
# api_only + public reads only the anonymous regional Spot API.
# Explicit spot_api also verifies current countries against the live official
# region directory; a metadata failure retains prices but excludes unverified
# countries from the compact regional CSV.
# A token alone never selects the account calculator; select api or catalog_api.
# Explicit api mode uses only project GET + calculator estimate-batch POST.
# catalog_api lists accessible tenants/projects/GPU presets and estimates each
# discovered configuration; see .env.nebius.example. Missing projects are gaps,
# not permission to invent prices in regions the account cannot query.
# Use a valid IAM Bearer access token; token renewal belongs to the caller.
NEBIUS_SOURCE=public
NEBIUS_ACCESS_TOKEN=
NEBIUS_CATALOG_BOOT_DISK_GIB=40
NEBIUS_CATALOG_CURRENCY=usd
# api requires ONE source of full configuration targets (1-20; <=256 KiB).
# Copy configs/nebius-targets.example.json to a *.local.json file, fill it,
# then set FILE. The example project and specs are not a verified live quote.
# Each target includes project_id, region, country_code, gpu_model, gpu_count,
# resource_specs, currency (usd/ils), aggregation_units (hour/month), and
# offer_types ([] or ["OFFER_TYPE_CONTRACT_PRICE"]). Contract prices remain account-specific.
# Relative FILE paths use the env file directory, otherwise the current cwd.
# Explicit FILE settings are validated even in public mode; leave blank here.
NEBIUS_PRICE_TARGETS_FILE=
# Alternative: a single literal JSON array. Do not set FILE and JSON together.
NEBIUS_PRICE_TARGETS_JSON=

# configured + public uses the public instance page even if a key exists.
# api_preferred/api_only + public selects the API when LAMBDA_API_KEY exists.
# Without a key, api_preferred uses the public page; api_only reports an error.
# api selects the authenticated public instance-types API (requires API key).
# console explicitly selects internal GET catalogs using your own saved login:
# see .env.lambda.example and docs/lambda-console.md. Capacity regions are
# availability metadata, never independently obtained regional price quotes.
LAMBDA_SOURCE=public
LAMBDA_API_KEY=
LAMBDA_STORAGE_STATE_PATH=

# UCloud public reads anonymous promotional monthly packages and official
# country/region/zone catalogs. Under configured, public ignores account keys.
# Under api_preferred/api_only, either key selects the authenticated quote API;
# both keys and valid full-configuration targets must then be configured.
# Without either key, these policies use the anonymous CompShare (优云智算)
# complete-configuration hourly quote API. The product line is explicitly labeled.
# Preserve offline status, eligibility conditions, and gpu_month units.
# api explicitly selects GetUHostInstancePrice; private key stays client-side.
UCLOUD_SOURCE=public
UCLOUD_PUBLIC_KEY=
UCLOUD_PRIVATE_KEY=
# Optional default project; UCloud requires it for sub-accounts.
UCLOUD_PROJECT_ID=
# api requires ONE source of full hourly host targets (1-20; <=128 KiB).
# Copy configs/ucloud-targets.example.json to *.local.json and fill every target
# BEFORE enabling keys under api_preferred/api_only. Then set its real FILE path.
# Specify region, zone, GPU, CPU, memory (MB), and disks (GB).
# Current target scope: MachineType=G, ChargeType=Dynamic, Count=1.
# Country/region/zone are checked against official catalogs on collection.
# Explicit FILE settings are validated in any mode; leave blank for public use.
UCLOUD_PRICE_TARGETS_FILE=
UCLOUD_PRICE_TARGETS_JSON=

# AutoDL public homepage: fresh unauthenticated browser, ordinary/member cards.
# Python Playwright/Chromium reads the rendered DOM, not an LLM or price API.
# api_only refuses this source; AUTODL_TOKEN does not enable a market-price API.
# market: direct official market JSON; no browser dependency during collection.
# Log into https://www.autodl.com/market/list in your regular browser.
# Open examples/autodl-session-export.html; its manual bookmarklet downloads
# a minimal token-only state. Set the absolute local file path below.
# Session files contain credentials. Keep them local and Git-ignored.
# market was independently live-verified using Python and CLI on 2026-10-22.
AUTODL_SOURCE=public
AUTODL_STORAGE_STATE_PATH=
# Reserved: not used by the current public or market collector.
AUTODL_TOKEN=

# For each provider's target FILE/JSON pair, setting either process variable
# selects the process layer for BOTH variables, including empty values.
# This permits explicitly clearing a target source loaded from an env file.
