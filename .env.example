# Read from process environment, not automatically loaded from .env.
# Inject values through your application or container --env-file.
# Live provider adapters are not implemented yet.
GPU_PRICE_MONITOR_PROVIDERS=nebius,crusoe
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2

# Lambda instance catalog.
LAMBDA_API_KEY=
# Nebius estimate API only; public pricing docs need no token.
NEBIUS_ACCESS_TOKEN=
# UCloud quotes; private key stays client-side.
UCLOUD_PUBLIC_KEY=
UCLOUD_PRIVATE_KEY=
# AutoDL API and an authorized browser storage-state file.
# An API token does not replace a browser session for market collection.
AUTODL_TOKEN=
AUTODL_STORAGE_STATE_PATH=
