# Public GPU price table + exact VM deployment directory. No login is required.
# Copy to .env.crusoe.local and load explicitly with --env-file.
GPU_PRICE_MONITOR_PROVIDERS=crusoe
GPU_PRICE_MONITOR_SOURCE_POLICY=api_preferred
GPU_PRICE_MONITOR_CATALOG_SCOPE=complete
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2
CRUSOE_SOURCE=public
# Deployment zones are coverage metadata, not proof of a region's quoted price.
# Contact sales has no numeric amount. No universal uniform-price claim is made.
# Optional account/combined modes audit existing contracts only; they do not
# provide a market price catalog. Leave all account fields empty for public mode.
CRUSOE_ACCESS_KEY_ID=
CRUSOE_SECRET_KEY=
CRUSOE_ORGANIZATION_ID=
