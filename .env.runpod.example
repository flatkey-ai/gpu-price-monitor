# Free, anonymous official RunPod GPU Pods API. No key or browser required.
# gpu-price-monitor collect --env-file .env.runpod.example --pretty
# Complete mode also checks the official datacenter-scoped minimum-price API.
# Catalog rates and datacenter starting rates remain separate observations.
GPU_PRICE_MONITOR_PROVIDERS=runpod
GPU_PRICE_MONITOR_SOURCE_POLICY=api_only
GPU_PRICE_MONITOR_CATALOG_SCOPE=complete
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2
