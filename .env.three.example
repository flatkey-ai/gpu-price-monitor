# Nebius / Lambda / Crusoe：三家完整公开目录，独立 Python 执行，不用 Codex / LLM。
# 复制为 .env.three.local 后显式加载，不覆盖已有 .env：
# gpu-price-monitor collect --env-file .env.three.local --catalog-scope complete --pretty
# 密钥全部留空即可采公开来源；complete 不表示所有账号 / 地区 / 销售报价都可取得。
GPU_PRICE_MONITOR_PROVIDERS=nebius,lambda,crusoe
GPU_PRICE_MONITOR_SOURCE_POLICY=api_preferred
GPU_PRICE_MONITOR_CATALOG_SCOPE=complete
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2

# Nebius public：官方费率 × preset 的计算记录、当前地区 Spot 与官网询价项。
# 派生配置不是额外独立报价；平台覆盖国家不当作价格国家。
# 账号估价须主动改 NEBIUS_SOURCE=api，并填写有效 IAM token 和真实完整 targets。
# 模板路径不预填，避免把未核验示例当作账号可售目标；FILE 与 JSON 二选一。
# catalog_api 可自动发现已有项目与 GPU presets 后只读估价，见 .env.nebius.example。
NEBIUS_SOURCE=public
NEBIUS_ACCESS_TOKEN=
NEBIUS_PRICE_TARGETS_FILE=
NEBIUS_PRICE_TARGETS_JSON=

# Lambda public：官网按需实例与预留集群条款。
# api_preferred 下填入 key 会选择认证 instance-types；容量地区不是独立地区报价。
# 显式账号调用：--providers lambda --lambda-source api；失败不回退网页。
LAMBDA_SOURCE=public
LAMBDA_API_KEY=

# Crusoe public + complete：官网 GPU instances 全部数值 / Contact sales、官方 VM 与部署区目录。
# 目录中的部署国家 / 可用区不当作价格适用地区；尚无统一地区价格证据。
# 可选 account（只读已有合同审计）或 combined（公开目录 + 已有合同审计）。
# 登录不等于获得全市场合同价；当前合同 API 缺结构化币种 / 小时单位 / GPU 类型证据。
# contract_records 不进入 GPU 小时报价 CSV，不猜 USD、卡数或地区价。
# 认证是官方 HMAC-SHA256 1.0；SECRET 为供应商生成的 URL-safe Base64 API secret，
# ACCESS_KEY_ID 为 API access key ID；不是普通 Bearer token。组织 ID 是 UUID。
CRUSOE_SOURCE=public
CRUSOE_ACCESS_KEY_ID=
CRUSOE_SECRET_KEY=
CRUSOE_ORGANIZATION_ID=

# .env.three.local、密钥、浏览器会话和私有 targets 不提交、不分享。
# 进程环境优先于该文件（包括空值），不执行 shell 或变量插值。
