# Collect the public price page and the catalogs visible to your own login.
# Records retain source labels; their total is not a deduplicated SKU count.
# API-only cannot include HTML. Use configured or api_preferred for this mode.
GPU_PRICE_MONITOR_PROVIDERS=lambda
GPU_PRICE_MONITOR_SOURCE_POLICY=configured
GPU_PRICE_MONITOR_CATALOG_SCOPE=complete
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2
LAMBDA_SOURCE=visible
# Save your own session locally as described in docs/lambda-console.md.
# No API key or resource creation is needed. Never commit this session.
LAMBDA_STORAGE_STATE_PATH=playwright/.auth/lambda.storage-state.json
