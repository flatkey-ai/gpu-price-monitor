# Free read-only Lambda console catalogs. No API key or payment required for
# the authenticated GETs verified on 2026-10-22. Internal API may change.
GPU_PRICE_MONITOR_PROVIDERS=lambda
GPU_PRICE_MONITOR_SOURCE_POLICY=api_only
GPU_PRICE_MONITOR_CATALOG_SCOPE=complete
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2
LAMBDA_SOURCE=console
# Own session only; never export another user's Chrome profile.
# Run: gpu-price-monitor lambda-login --state-file playwright/.auth/lambda.storage-state.json
# Relative to this env file, not to the installed package.
LAMBDA_STORAGE_STATE_PATH=playwright/.auth/lambda.storage-state.json
