# Original document scope: Nebius, Lambda, Crusoe, AutoDL, UCloud.
# Copy to .env.five.local (keep existing .env), then explicitly load it:
# gpu-price-monitor collect --env-file .env.five.local --pretty
# Python: Settings.from_env(env_file=".env.five.local")
# Runtime uses ordinary Python/HTTP/HTML/DOM code; no Codex or LLM service.
# Process environment overrides this file, including empty values.
GPU_PRICE_MONITOR_PROVIDERS=nebius,lambda,crusoe,autodl,ucloud
GPU_PRICE_MONITOR_SOURCE_POLICY=api_preferred
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2

# API preference is not a promise that every provider exposes a market-price API.
# configured preserves explicit SOURCE choices; api_only rejects page/DOM sources.
# A selected API failure is returned as an error, never hidden by page fallback.

# Nebius: anonymous regional Spot API plus official website JSON on-demand
# catalog under api_preferred. api_only keeps only the regional Spot API.
# Catalog regions are unspecified; they are not copied into regional prices.
# A token alone does not switch to the account configuration calculator.
# To use that calculator, explicitly set NEBIUS_SOURCE=api, supply a valid IAM
# token, and fill ONE target source using configs/nebius-targets.example.json.
NEBIUS_SOURCE=public
NEBIUS_ACCESS_TOKEN=
NEBIUS_PRICE_TARGETS_FILE=
NEBIUS_PRICE_TARGETS_JSON=

# Lambda: a supplied key selects the official instance-types API under
# api_preferred; with no key, deterministic code parses its public price page.
# Capacity locations in an API response are not independent regional tariffs.
LAMBDA_SOURCE=public
LAMBDA_API_KEY=

# Crusoe: deterministic Python parsing of its official GPU pricing page.
# No verified public market-price API; no Crusoe credential is required.

# AutoDL: deterministic Playwright/Chromium DOM parsing of ordinary/member
# homepage prices. Install the browser extra and Chromium first:
# pip install '.[browser]'
# python -m playwright install chromium
# Homepage prices do not establish country/region-specific market prices.
# The developer Token APIs describe existing resources, not a full market catalog.
AUTODL_SOURCE=public
AUTODL_STORAGE_STATE_PATH=
AUTODL_TOKEN=

# UCloud: without keys, api_preferred/api_only use the free CompShare (优云智算)
# complete-configuration hourly quotation API, with verified request locations.
# The product line is labeled separately from UHost. configured mode retains
# the original monthly promotion source; no monthly-to-hourly price is invented.
# Under api_preferred, EITHER key selects GetUHostInstancePrice. Before enabling
# keys, copy configs/ucloud-targets.example.json to a Git-ignored *.local.json,
# fill actual region/zone/GPU/CPU/memory/disks, then set its real FILE path below.
# Both keys and ONE complete target source are required for authenticated quotes.
# Never set an unfilled example path as a runnable default.
UCLOUD_SOURCE=public
UCLOUD_PUBLIC_KEY=
UCLOUD_PRIVATE_KEY=
# Optional project ID; required by UCloud for sub-accounts.
UCLOUD_PROJECT_ID=
UCLOUD_PRICE_TARGETS_FILE=
UCLOUD_PRICE_TARGETS_JSON=

# FILE paths are relative to this env file. Do not set FILE and JSON together.
# Credentials and local target files must not be committed or shared.
