# Account discovery + read-only regional configuration estimates.
# Copy to .env.nebius.local, then supply your own existing-user access token.
# No VM, project, disk, reservation, API key or payment is created by this library.
GPU_PRICE_MONITOR_PROVIDERS=nebius
GPU_PRICE_MONITOR_SOURCE_POLICY=api_only
GPU_PRICE_MONITOR_CATALOG_SCOPE=complete
GPU_PRICE_MONITOR_TIMEOUT_SECONDS=30
GPU_PRICE_MONITOR_MAX_RETRIES=2
NEBIUS_SOURCE=catalog_api
# Official OAuth CLI: nebius iam get-access-token (typically valid for 12 hours).
# The token inherits your user permissions. Never share or commit this file.
NEBIUS_ACCESS_TOKEN=
# Main rate = discovered preset GPU + CPU + RAM compute cost, per GPU-hour.
# The same batch separately estimates this SSD; storage_quote is extra.
# full_configuration_price keeps VM + one disk per-instance-hour total.
NEBIUS_CATALOG_BOOT_DISK_GIB=40
NEBIUS_CATALOG_CURRENCY=usd
# Discovery replaces manual quote targets in catalog_api mode.
NEBIUS_PRICE_TARGETS_FILE=
NEBIUS_PRICE_TARGETS_JSON=
